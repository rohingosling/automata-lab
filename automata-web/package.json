{
  "name": "automata-lab",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.15.0",
    "npm": "11.12.1"
  },
  "scripts": {
    "predev": "npm run icons:check && npm run schema:check && npm --prefix ../documentation run build",
    "dev": "node scripts/run-development-servers.mjs",
    "prebuild": "npm run icons:check && npm run schema:check && npm run audit:runtime",
    "build": "vite build && node scripts/verify-artifact.mjs",
    "build:pages": "node scripts/build-pages-artifact.mjs",
    "documentation:ci": "npm --prefix ../documentation ci",
    "test:documentation": "npm --prefix ../documentation run test",
    "audit:runtime": "node scripts/audit-runtime-dependencies.mjs",
    "audit:runtime:write": "node scripts/audit-runtime-dependencies.mjs --write",
    "audit:advisories:offline": "npm audit --offline --omit=dev --audit-level=low",
    "chart:lock": "node scripts/lock-chart-algorithms.mjs",
    "schema:check": "node scripts/generate-schema-validator.mjs --check",
    "schema:generate": "node scripts/generate-schema-validator.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:performance": "vitest run --config vitest.performance.config.mjs",
    "test:routing-performance": "vitest run --config vitest.chart-routing-benchmark.config.mjs",
    "test:model": "vitest run tests/model tests/runtime tests/domain-solver tests/application tests/infrastructure",
    "test:server": "vitest run tests/server tests/application/server-workspace.test.ts tests/infrastructure/server-worker.test.ts tests/shell/Application.server.test.tsx",
    "test:solver": "vitest run tests/solver tests/domain-solver tests/application/solver-workspace.test.ts tests/infrastructure/solver-worker.test.ts tests/shell/SolverPage.test.tsx",
    "test:shell": "vitest run tests/shell",
    "test:browser:install": "playwright install chromium firefox webkit",
    "test:browser": "playwright test",
    "test:accessibility": "playwright test tests/browser/accessibility.spec.ts",
    "test:artifact": "node scripts/verify-artifact.mjs",
    "icons:check": "node scripts/manage-fluent-icons.mjs check",
    "icons:import": "node scripts/manage-fluent-icons.mjs import",
    "verify": "npm run schema:check && npm run typecheck && npm run lint && npm run test:unit && npm run test:performance && npm run documentation:ci && npm run test:documentation && npm run build:pages && npm run test:browser"
  },
  "dependencies": {
    "@xyflow/react": "12.11.2",
    "elkjs": "0.12.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "ajv": "8.20.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fast-check": "4.9.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
