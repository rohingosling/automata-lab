{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rohingosling.github.io/automata-lab/schema/automata-lab-state-machine-1.0.0.schema.json",
  "title": "Automata Lab State Machine 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "file_id",
    "file_version",
    "settings",
    "state_machine",
    "chart",
    "solver",
    "simulator"
  ],
  "properties": {
    "file_id": {
      "const": "automata-lab-state-machine"
    },
    "file_version": {
      "const": "1.0.0"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "version"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        }
      }
    },
    "state_machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_state",
        "events",
        "states",
        "actions",
        "state_actions",
        "transition_table"
      ],
      "properties": {
        "initial_state": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/name" }
          ]
        },
        "events": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/named_entity" }
        },
        "states": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/named_entity" }
        },
        "actions": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/named_entity" }
        },
        "state_actions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entry", "exit"],
          "properties": {
            "entry": {
              "type": "array",
              "maxItems": 50000,
              "items": { "$ref": "#/$defs/state_action" }
            },
            "exit": {
              "type": "array",
              "maxItems": 50000,
              "items": { "$ref": "#/$defs/state_action" }
            }
          }
        },
        "transition_table": {
          "type": "array",
          "maxItems": 50000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "event", "state_next"],
            "properties": {
              "state": { "$ref": "#/$defs/name" },
              "event": { "$ref": "#/$defs/name" },
              "state_next": { "$ref": "#/$defs/name" }
            }
          }
        }
      }
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["settings", "indicators", "states"],
      "properties": {
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expand_states"],
          "properties": {
            "expand_states": { "type": "boolean" },
            "state_origin_centered": { "type": "boolean" }
          }
        },
        "indicators": {
          "type": "object",
          "additionalProperties": false,
          "required": ["initial_state_indicator"],
          "properties": {
            "initial_state_indicator": {
              "anyOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["x", "y"],
                  "properties": {
                    "state": {
                      "anyOf": [
                        { "type": "null" },
                        { "$ref": "#/$defs/name" }
                      ]
                    },
                    "x": { "type": "number" },
                    "y": { "type": "number" }
                  }
                }
              ]
            },
            "terminal_state_indicators": {
              "type": "array",
              "maxItems": 10000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "x", "y"],
                "properties": {
                  "id": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                  "x": { "type": "number" },
                  "y": { "type": "number" }
                }
              }
            },
            "terminal_state_transitions": {
              "type": "array",
              "maxItems": 10000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["state", "terminal_state_indicator_id"],
                "properties": {
                  "state": { "$ref": "#/$defs/name" },
                  "terminal_state_indicator_id": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                }
              }
            }
          }
        },
        "states": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "x", "y"],
            "properties": {
              "state": { "$ref": "#/$defs/name" },
              "x": { "type": "number" },
              "y": { "type": "number" },
              "width": { "type": "number", "minimum": 1, "maximum": 4096 },
              "height": { "type": "number", "minimum": 1, "maximum": 4096 }
            }
          }
        },
        "draft_transitions": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "source", "target"],
            "properties": {
              "id": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "source": { "$ref": "#/$defs/point" },
              "target": { "$ref": "#/$defs/point" }
            }
          }
        }
      }
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequences"],
      "properties": {
        "sequences": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description", "start_context", "sequence"],
            "properties": {
              "name": { "$ref": "#/$defs/name" },
              "description": { "$ref": "#/$defs/description" },
              "start_context": { "enum": ["initial", "continuation", "infer"] },
              "sequence": {
                "type": "array",
                "maxItems": 50000,
                "items": { "type": "string", "maxLength": 128 }
              }
            }
          }
        }
      }
    },
    "simulator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequences"],
      "properties": {
        "sequences": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description", "sequence"],
            "properties": {
              "name": { "$ref": "#/$defs/name" },
              "description": { "$ref": "#/$defs/description" },
              "sequence": {
                "type": "array",
                "maxItems": 10000,
                "items": { "$ref": "#/$defs/name" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "maxLength": 4096
    },
    "named_entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" }
      }
    },
    "state_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "action"],
      "properties": {
        "state": { "$ref": "#/$defs/name" },
        "action": { "$ref": "#/$defs/name" }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    }
  }
}
